# Dependencias
node_modules/

# Binarios empaquetados / artefactos de despliegue (muy pesados)
dist/
*.exe
*.exe.bak
*.exe.*
*.zip

# ------------------------------------------------------------------
#  Bases de datos
#
#  reportes.db SI se versiona: es la BD base (esquema + dispositivo
#  por defecto, sin datos reales) para que un pull limpio ya arranque
#  con la base lista. Se regenera con: npm run db:init
#
#  El WAL y cualquier otra copia NO se versionan.
# ------------------------------------------------------------------
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# Respaldos de la base (contienen datos de produccion)
reportes.db.bak*
reportes.db.pre-*
reportes.db.consolidated-*
*.db.dump
*.sql.gz

# Logs
*.log
logs/

# Salida de comandos suelta (archivo "1" creado por error)
/1

# Config / secretos locales
.env
.env.*
!.env.example

# SO / editores
.DS_Store
Thumbs.db
.vscode/
.idea/

# Temporal / artefactos sueltos
*.tmp
*.bak
serverpid.txt